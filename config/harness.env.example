# Copy to ~/.config/harnessvla/ur5.env, chmod 600, then fill the key locally.
OPENAI_API_KEY=
HARNESSVLA_MODEL=openai-responses:gpt-6-astra
HARNESSVLA_BASE_URL=https://api.openai.com/v1
HARNESSVLA_REASONING_EFFORT=low
# Optional per-process proxy. Direct robot TCP/serial connections use local devices.
# HTTP_PROXY=http://127.0.0.1:18080
# HTTPS_PROXY=http://127.0.0.1:18080
# NO_PROXY=localhost,127.0.0.1,::1
